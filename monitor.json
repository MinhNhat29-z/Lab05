    {
      "name": "GET /users - Status and Response Time",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test('Response time is measured', function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.a('number');\r",
              "    if (pm.response.responseTime >= 800) {\r",
              "        console.warn('WARNING: Response time is ' + pm.response.responseTime + 'ms (threshold: 800ms)');\r",
              "    }\r",
              "});\r",
              "pm.test('Response is valid JSON', function () {\r",
              "    pm.response.to.be.json;\r",
              "});"
            ],
